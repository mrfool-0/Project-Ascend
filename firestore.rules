rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    function validOnboarding() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'displayName', 'birthDate', 'heightCm', 'weightKg', 'targetWeightKg',
          'objective', 'activity', 'experience', 'equipment', 'diet', 'focusAreas',
          'injuries', 'injuryNotes', 'workoutFrequency', 'trainingSplit', 'workoutDays',
          'futureVision', 'coreReason', 'minimumPromise', 'syncedAt'
        ])
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.birthDate is string && data.birthDate.size() == 10
        && data.heightCm is number && data.heightCm >= 90 && data.heightCm <= 260
        && data.weightKg is number && data.weightKg >= 25 && data.weightKg <= 400
        && data.targetWeightKg is number && data.targetWeightKg >= 25 && data.targetWeightKg <= 400
        && data.objective is string && data.objective.size() >= 3 && data.objective.size() <= 32
        && data.activity is string && data.activity.size() >= 3 && data.activity.size() <= 32
        && data.experience is string && data.experience.size() >= 3 && data.experience.size() <= 32
        && data.equipment is string && data.equipment.size() >= 3 && data.equipment.size() <= 32
        && data.diet is string && data.diet.size() >= 3 && data.diet.size() <= 32
        && data.trainingSplit is string && data.trainingSplit.size() >= 3 && data.trainingSplit.size() <= 32
        && data.workoutFrequency is int && data.workoutFrequency >= 2 && data.workoutFrequency <= 6
        && data.focusAreas is list && data.focusAreas.size() >= 1 && data.focusAreas.size() <= 9
        && data.injuries is list && data.injuries.size() <= 9
        && data.workoutDays is list && data.workoutDays.size() == data.workoutFrequency
        && data.injuryNotes is string && data.injuryNotes.size() <= 500
        && data.futureVision is string && data.futureVision.size() <= 240
        && data.coreReason is string && data.coreReason.size() <= 240
        && data.minimumPromise is string && data.minimumPromise.size() <= 240
        && data.syncedAt == request.time;
    }

    function validCurrentProgress() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'displayName', 'objective', 'focusAreas', 'workoutDays', 'currentWeightKg',
          'targetWeightKg', 'calorieTarget', 'proteinTarget', 'lifetimeXp',
          'recentDailyProgress', 'syncedAt'
        ])
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.objective is string && data.objective.size() >= 3 && data.objective.size() <= 32
        && data.focusAreas is list && data.focusAreas.size() >= 1 && data.focusAreas.size() <= 9
        && data.workoutDays is list && data.workoutDays.size() >= 2 && data.workoutDays.size() <= 6
        && data.currentWeightKg is number && data.currentWeightKg >= 25 && data.currentWeightKg <= 400
        && data.targetWeightKg is number && data.targetWeightKg >= 25 && data.targetWeightKg <= 400
        && data.calorieTarget is int && data.calorieTarget >= 1000 && data.calorieTarget <= 8000
        && data.proteinTarget is int && data.proteinTarget >= 20 && data.proteinTarget <= 400
        && data.lifetimeXp is int && data.lifetimeXp >= 0 && data.lifetimeXp <= 100000000
        && data.recentDailyProgress is list && data.recentDailyProgress.size() <= 31
        && data.syncedAt == request.time;
    }

    match /players/{userId} {
      allow read, write: if false;

      match /progress/{documentId} {
        allow get: if isVerifiedOwner(userId) && documentId in ['onboarding', 'current'];
        allow create, update: if isVerifiedOwner(userId)
          && (
            (documentId == 'onboarding' && validOnboarding())
            || (documentId == 'current' && validCurrentProgress())
          );
        allow list, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
